# Application
APP_NAME="StockAnalysis Screener API"
ENVIRONMENT="local"
DEBUG=true

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stock_screener
POSTGRES_USER=stock_apps
POSTGRES_PASSWORD=replace-with-a-strong-local-password
EXTERNAL_DATABASE_URL=postgresql+asyncpg://stock_apps:replace-with-a-strong-local-password@localhost:5432/stock_announcement

# Local authentication and optional providers
OTP_VALID_WINDOW=60
IS_PRODUCTION=false
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
SECRET_KEY=replace-with-a-random-secret
ANGLE_ONE_API_KEY=
ANGLE_ONE_CLIENT_ID=
ANGLE_ONE_CLIENT_CODE=
ANGLE_ONE_CLIENT_PASSWORD=
ANGLE_ONE_TOTP_SECRET=
SCRAPINGBEE_API_KEY=

# Fast market-data pipeline
YAHOO_CONCURRENCY=12
YAHOO_BATCH_SIZE=500
YAHOO_TIMEOUT_SECONDS=15
YAHOO_RETRIES=3
YAHOO_REQUESTS_PER_SECOND=10
YAHOO_SYMBOL_QUARANTINE_SECONDS=604800
NSE_REQUESTS_PER_SECOND=4
BSE_REQUESTS_PER_SECOND=4
MARKET_SHARD_COUNT=8
MARKET_SHARD_SIZE=250
MARKET_RETRY_BATCH_SIZE=250
MARKET_MAX_RETRY_ATTEMPTS=3
SCREENER_WORKER_CONCURRENCY=8
SCREENER_PROXY_CONFIG=config/proxies.json
PROXY_FAILURE_THRESHOLD=3
PROXY_COOLDOWN_SECONDS=60
PROXY_LEASE_TTL_SECONDS=45
PROXY_ACQUIRE_TIMEOUT_SECONDS=60
YAHOO_DIRECT_MAX_CONCURRENCY=4
YAHOO_PROXY_1_URL=
YAHOO_PROXY_2_URL=
YAHOO_PROXY_3_URL=
YAHOO_PROXY_4_URL=
YAHOO_PROXY_5_URL=
YAHOO_PROXY_6_URL=
YAHOO_PROXY_7_URL=
YAHOO_PROXY_8_URL=
ENABLE_LEGACY_MARKET_JOBS=false

# Connection pools, Redis, and API protection
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
REDIS_URL=redis://localhost:6379/0
REDIS_SECONDARY_URL=redis://localhost:6379/10
API_RATE_LIMIT_PER_MINUTE=600
API_MAX_CONCURRENCY=50
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3
